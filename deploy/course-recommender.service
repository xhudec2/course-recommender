[Unit]
Description=Course Recommender FastAPI backend
After=network.target

[Service]
Type=simple
User=opc
WorkingDirectory=/home/opc/course-recommender
EnvironmentFile=/etc/course-recommender.env
ExecStart=/usr/local/bin/uv run uvicorn recommender:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
